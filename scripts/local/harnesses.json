{
  "codex": {
    "display": "Codex",
    "instructions": "~/.codex/AGENTS.md",
    "skills_dir": "~/.agents/skills",
    "other_skills_dirs": ["~/.codex/skills"],
    "env_vars": ["COMITIA_AGENT_INSTANCE", "COMITIA_AGENT_INSTANCE_LABEL"],
    "mcp": {"file": "~/.codex/config.toml", "format": "toml", "key": "mcp_servers"},
    "approval": {"format": "entry", "key": "default_tools_approval_mode", "value": "approve"}
  },
  "claude": {
    "display": "Claude",
    "instructions": "~/.claude/CLAUDE.md",
    "skills_dir": "~/.claude/skills",
    "mcp": {"file": "~/.claude.json", "format": "json", "key": "mcpServers"},
    "approval": {"format": "list", "file": "~/.claude/settings.json", "key": "permissions.allow", "value": "mcp__comitia__*"}
  }
}
