# Build output
# A comitia binary built into the root by a bare `go build ./cmd/comitia`;
# the leading slash keeps cmd/comitia, pkg/comitia and skills/comitia tracked.
/comitia
/bin/
/dist/
*.test
*.out

# Interpreter and tool caches written by installers and tests
__pycache__/
*.pyc
node_modules/

# Local state and secrets
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# Editor and OS files
.DS_Store
.idea/
.vscode/
